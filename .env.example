# ============================================================
# AI-KM 知识管理平台 · 环境变量示例
# 复制本文件为 .env 并填入真实值；所有项均可被环境变量覆盖。
# 优先级：真实环境变量 > .env > 代码默认值
# ============================================================

# ---------- Web 服务 ----------
# 服务监听地址（内网部署用 0.0.0.0）
AIKM_HOST=0.0.0.0
# 服务端口（避开现有 5100 智采日报）
AIKM_PORT=5200
# 调试模式（生产必须 false，否则泄露堆栈）
AIKM_DEBUG=false
# Flask 会话签名密钥（【生产必改】务必改为随机长字符串，否则会话可被伪造）
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
# 未设置时应用会临时随机生成（每次重启登录态失效），仅限本地临时演示。
AIKM_SECRET_KEY=change-me-to-a-random-secret-string
# 会话有效期（小时）
AIKM_SESSION_HOURS=8
# 是否处于 HTTPS 环境（前方有 Nginx 等做了 TLS 终止时设 true）。
# true 会让会话 Cookie 标记为 Secure 并启用 HSTS；纯 HTTP 内网用 false。
AIKM_HTTPS=false
# 登录暴力破解防护：单「账号+IP」在 15 分钟内连续失败达上限即临时锁定
AIKM_LOGIN_MAX_FAIL=5
AIKM_LOGIN_LOCK_MIN=15
AIKM_LOGIN_FAIL_WINDOW=15

# ---------- 大模型（问答生成） ----------
# 服务商：deepseek / openai / ollama（10月私有化改 ollama 即可，业务代码零改动）
AIKM_LLM_PROVIDER=deepseek
AIKM_LLM_BASE_URL=https://api.deepseek.com/v1
# DeepSeek API Key（替换为你的真实密钥）
AIKM_LLM_API_KEY=sk-your-deepseek-key
AIKM_LLM_MODEL=deepseek-chat
AIKM_LLM_TIMEOUT=120
AIKM_LLM_TEMPERATURE=0.1

# ---------- 向量模型（语义检索） ----------
# 服务商：siliconflow / openai / ollama / hash
# hash = 无外网时的本地降级方案（基于字符哈希，效果一般但保证可跑）
AIKM_EMBED_PROVIDER=siliconflow
AIKM_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# 硅基流动 API Key（替换为你的真实密钥；本地无网可设 hash 走降级）
AIKM_EMBED_API_KEY=sk-your-siliconflow-key
AIKM_EMBED_MODEL=BAAI/bge-m3
# 向量维度，切换模型时必须同步修改并重建索引
AIKM_EMBED_DIM=1024
AIKM_EMBED_BATCH=16
AIKM_EMBED_TIMEOUT=60

# ---------- 数据目录（迁移时整个目录拷走即可） ----------
# AIKM_DATA_DIR=./data
# AIKM_DB_PATH=./data/aikm.db

# ---------- 入库与检索调参（一般无需改） ----------
AIKM_MAX_FILE_SIZE_MB=50
AIKM_MIN_CONTENT_LENGTH=200
AIKM_CHUNK_SIZE=600
AIKM_CHUNK_OVERLAP=80
AIKM_SEARCH_TOP_K=10
AIKM_RECALL_TOP_K=50
AIKM_RRF_K=60

# ---------- 安全与审计 ----------
AIKM_PASSWORD_ITERATIONS=200000
AIKM_API_RATE_LIMIT=60
# 审计日志保留天数（0 = 永久保留，合规场景建议永久）
AIKM_AUDIT_RETAIN_DAYS=0

# ============================================================
# P2 安全增强：MFA / SSO / 标准 REST API（一般无需改）
# ============================================================

# ---------- MFA 多因子认证（TOTP） ----------
# 全局开关：true 时用户可自愿在「我的安全」页扫码开通
AIKM_MFA_ENABLED=true
# 二维码里显示的发行方名称（出现在用户的验证器 App 中）
AIKM_MFA_ISSUER=AI-KM
# 开通时生成的备用码数量（手机丢失时紧急登录用，用一次少一个）
AIKM_MFA_BACKUP_COUNT=8

# ---------- SSO / LDAP / OIDC 单点登录 ----------
# 总开关：false 时所有 SSO 路由直接提示"未启用"
AIKM_SSO_ENABLED=false
# 协议：ldap / oidc
AIKM_SSO_PROVIDER=ldap
# SSO 登录成功但本地无账号时，是否自动建号（最小权限角色）
AIKM_SSO_AUTO_CREATE_USER=true
AIKM_SSO_DEFAULT_ROLE=user
AIKM_SSO_DEFAULT_DEPT=知识管理中心

# LDAP 连接配置（仅 SSO_PROVIDER=ldap 时使用）
AIKM_LDAP_SERVER=ldap://10.0.0.10:389
AIKM_LDAP_BIND_DN=cn=bind,dc=corp,dc=com
AIKM_LDAP_BIND_PWD=bind-password
AIKM_LDAP_USER_BASE=ou=users,dc=corp,dc=com
AIKM_LDAP_USER_FILTER=(uid={username})
AIKM_LDAP_TLS=false

# OIDC 配置（仅 SSO_PROVIDER=oidc 时使用）
AIKM_OIDC_ISSUER=https://sso.corp/auth/realms/km
AIKM_OIDC_CLIENT_ID=aikm-client
AIKM_OIDC_CLIENT_SECRET=oidc-secret
AIKM_OIDC_REDIRECT_URI=http://localhost:5200/api/sso/oidc/callback

# ---------- 标准 REST API v1 ----------
# 资源式 REST 接口前缀（与老的 /api/ 动作式接口区分）
AIKM_API_V1_PREFIX=/api/v1
AIKM_REST_PAGE_SIZE=20
AIKM_REST_MAX_PAGE_SIZE=100
