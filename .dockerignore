# AI-KM 构建上下文忽略清单
# 目的：避免把密钥、运行时数据与缓存打进镜像，减小镜像体积并防止敏感信息泄露。

# 密钥与环境（绝不进镜像；运行时由 docker-compose 的 env_file 或真实环境变量注入）
.env
.env.*
!.env.example

# 运行时数据（数据库/上传/索引应由卷挂载持久化，不应烘焙进镜像）
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python 缓存与临时文件
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 本地开发/测试产物
tests/
/tmp/
*.log

# 版本控制与 CI
.git/
.gitignore

# 操作系统垃圾文件
.DS_Store
Thumbs.db
